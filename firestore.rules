rules_version = '2';

// Rosebella — Firestore security rules
// Publish in Firebase console → Firestore Database → Rules.
//
// Storefront (rosebella-website) reads catalog/config publicly and creates
// orders. Only admins signed in to the admin portal (rosebella-admin) can
// change the catalog and settings or read orders and customers.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['yousefaljailey@gmail.com'];
    }

    // Products + collections (single doc: catalog/main)
    match /catalog/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site settings (config/settings) and hero slides (config/heroSlides)
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Storefront orders: anyone can place one, only admins can see or change them
    match /orders/{orderId} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.total is number
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 100;
      allow read, update, delete: if isAdmin();
    }

    // Public order status (no personal details) so customers can track by order ID
    match /orderStatus/{orderId} {
      allow get: if true;
      allow create: if request.resource.data.status == 'pending';
      allow update, delete, list: if isAdmin();
    }

    // POS records (sales, inventory, CRM, wire orders) — admin portal only
    match /adminData/{doc} {
      allow read, write: if isAdmin();
    }

    // Customer profiles: each signed-in customer manages their own doc
    match /customers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }
  }
}
